<div class="cta-strip" id="join">
  <div class="cta-text">
    <span class="cta-sub">Join the movement</span>
    Train hard. Live fully. No apologies.
  </div>
  <a href="mailto:hello@builtnotobsessed.com" class="btn-dark">Get Started Free</a>
</div>

<footer>
  <div class="footer-brand">
    <div class="footer-logo">BUILT NOT OBSESSED</div>
    <div class="footer-tagline">Built to last. Made to live.</div>
  </div>
  <div class="footer-links">
    <a href="#training">Training</a>
    <a href="#nutrition">Nutrition</a>
    <a href="#philosophy">About</a>
    <a href="mailto:hello@builtnotobsessed.com">Contact</a>
  </div>
  <div class="footer-copy">© 2026 Built Not Obsessed</div>
</footer>

<style>
  .cta-strip {
    background: var(--amber);
    padding: 4rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-text {
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--ink);
    line-height: 1;
  }

  .cta-sub {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.3em;
    font-weight: 400;
    font-style: italic;
    opacity: 0.7;
  }

  .btn-dark {
    background: var(--ink);
    color: var(--amber);
    padding: 1rem 2.5rem;
    border-radius: 2px;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }

  .btn-dark:hover {
    opacity: 0.85;
  }

  footer {
    background: #09090a;
    padding: 3rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
    border-top: 1px solid rgba(200, 131, 42, 0.15);
  }

  .footer-logo {
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: 1.4rem;
    color: var(--amber);
    letter-spacing: 0.1em;
  }

  .footer-tagline {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-top: 0.25rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--amber);
  }

  .footer-copy {
    font-size: 0.7rem;
    color: rgba(122, 114, 104, 0.5);
  }
</style>
