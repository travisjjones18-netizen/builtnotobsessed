---
const cards = [
  {
    num: '01',
    icon: '🏋️',
    title: 'Lift with intention',
    text: 'You don\'t need to live in the gym. Four solid sessions a week, compound movements, progressive overload — that\'s 90% of the results. The other 10%? That\'s the life you\'re building the body for.',
  },
  {
    num: '02',
    icon: '🍺',
    title: 'Eat and drink well',
    text: 'Protein matters. Vegetables matter. So does that Saturday night out. We teach you to eat for performance and pleasure — not as separate goals, but as the same one.',
  },
  {
    num: '03',
    icon: '⚖️',
    title: 'The 70/30 rule',
    text: 'Hit your targets 80% of the time. The other 20% is brunch, birthday cake, and craft beer. This isn\'t a cheat day — it\'s just called having a life. Consistency beats perfection every single time.',
  },
  {
    num: '04',
    icon: '🧠',
    title: 'Mental health is training too',
    text: 'Obsessing over macros and skipping social events is not health — it\'s anxiety with a six-pack. We train the whole person: body, mind, and the ability to be present in your own damn life.',
  },
];
---

<section id="philosophy" class="section">
  <div class="section-label">Our philosophy</div>
  <div class="philosophy-grid">
    {cards.map(card => (
      <div class="phil-card">
        <div class="phil-num">{card.num}</div>
        <div class="phil-icon">{card.icon}</div>
        <h3 class="phil-title">{card.title}</h3>
        <p class="phil-text">{card.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .section {
    padding: 6rem 2.5rem;
  }

  .section-label {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--amber);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .section-label::after {
    content: '';
    flex: 1;
    max-width: 60px;
    height: 1px;
    background: var(--amber);
    opacity: 0.5;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid rgba(200, 131, 42, 0.2);
  }

  .phil-card {
    padding: 3rem 2.5rem;
    border-right: 1px solid rgba(200, 131, 42, 0.2);
    border-bottom: 1px solid rgba(200, 131, 42, 0.2);
    position: relative;
    overflow: hidden;
    transition: background 0.3s;
  }

  .phil-card:nth-child(even) { border-right: none; }
  .phil-card:nth-child(3),
  .phil-card:nth-child(4) { border-bottom: none; }
  .phil-card:hover { background: rgba(200, 131, 42, 0.04); }

  .phil-num {
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: 5rem;
    color: rgba(200, 131, 42, 0.12);
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    line-height: 1;
    user-select: none;
  }

  .phil-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .phil-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--cream);
  }

  .phil-text {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.7;
    font-weight: 300;
  }

  @media (max-width: 768px) {
    .philosophy-grid { grid-template-columns: 1fr; }
    .phil-card:nth-child(even) { border-right: 1px solid rgba(200,131,42,0.2); }
    .phil-card:nth-child(3) { border-bottom: 1px solid rgba(200,131,42,0.2); }
  }
</style>
